{
  "name": "mplocaltime-api",
  "version": "1.0.0",
  "description": "Minimal API for mplocaltime contributor flow",
  "author": "mplocaltime-ceo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mplocaltime-ceo/mplocaltime.git"
  },
  "bugs": {
    "url": "https://github.com/mplocaltime-ceo/mplocaltime/issues"
  },
  "homepage": "https://github.com/mplocaltime-ceo/mplocaltime#readme",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node init_db.js",
    "db:migrate": "node scripts/run-migrations.js",
    "db:status": "node scripts/db-status.js",
    "db:backup": "node scripts/db-backup.js",
    "db:import-sqlite": "node scripts/db-import-sqlite.js",
    "db:verify": "node scripts/db-verify.js",
    "production:check": "NODE_ENV=production node scripts/production-check.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 tests/**/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^7.0.13",
    "sanitize-html": "^2.1.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
