NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data.db
TRUST_PROXY=0

# Required security values for production.
JWT_SECRET=replace-with-secure-random-secret
INITIAL_PASSWORD=replace-with-secure-admin-password
INITIAL_USER_PASSWORD=replace-with-secure-contributor-password

# Production base URL used for canonical URLs, sitemap, RSS, robots.txt and
# metadata. Must be the trusted production domain, not a request Host header.
SITE_URL=http://localhost:3000

# Media upload storage should sit outside publicly served document roots in
# production whenever practical.
MEDIA_UPLOAD_DIR=./data/uploads
MEDIA_MAX_BYTES=10485760

# Google AdSense remains disabled unless the real publisher ID is obtained from
# the approved Google account and the feature is explicitly enabled.
ADSENSE_ENABLED=false
ADSENSE_PUBLISHER_ID=
ADSENSE_ADS_TXT_ENTRY=
