NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data.db
TRUST_PROXY=0

JWT_SECRET=replace-with-secure-random-secret
INITIAL_PASSWORD=replace-with-secure-admin-password
INITIAL_USER_PASSWORD=replace-with-secure-contributor-password

# Production base URL used to build canonical URLs, sitemaps, the RSS feed and
# robots.txt. Must not be derived from request Host headers.
SITE_URL=http://localhost:3000

# Media upload storage is intentionally local by default and should be kept out
# of public web roots in production.
MEDIA_UPLOAD_DIR=./public/uploads/news
MEDIA_MAX_BYTES=10485760

# Google AdSense remains disabled unless the real publisher ID is obtained from
# the approved Google account and the feature is explicitly enabled.
ADSENSE_ENABLED=false
ADSENSE_PUBLISHER_ID=
ADSENSE_ADS_TXT_ENTRY=

VERCEL_TOKEN=replace_this_with_a_vercel_token
